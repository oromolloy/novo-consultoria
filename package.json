{
  "name": "novo-consultoria",
  "version": "1.0.0",
  "private": true,
  "description": "Site estático — SCSS + HTML",
  "scripts": {
    "build": "sass main.scss main.css --no-source-map",
    "build:prod": "sass main.scss main.css --style=compressed --no-source-map",
    "watch": "sass --watch main.scss:main.css --no-source-map",
    "hot": "concurrently -n sass,web -c cyan,magenta \"npm run watch\" \"browser-sync start --config bs-config.js\"",
    "dev": "npm run hot"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.1.2",
    "sass": "^1.85.0"
  }
}
